generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Stage {
  WISHLIST
  APPLIED
  ASSESSMENT
  PHONE_SCREEN
  INTERVIEW
  OFFER
  ACCEPTED
  REJECTED
  WITHDRAWN
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  inboundToken String        @unique @default(cuid())
  createdAt    DateTime      @default(now())
  applications Application[]
}

model Application {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   String
  role      String
  jobUrl    String?
  location  String?
  source    String?
  notes     String?
  stage     Stage        @default(APPLIED)
  appliedAt DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  events    StageEvent[]
  reminders Reminder[]
  contacts  Contact[]
  emails    EmailLog[]

  @@index([userId, stage])
}

model StageEvent {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStage     Stage?
  toStage       Stage
  createdAt     DateTime    @default(now())
}

model Reminder {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          String // FOLLOW_UP, INTERVIEW, DEADLINE
  dueAt         DateTime
  done          Boolean     @default(false)
  notifiedAt    DateTime?

  @@index([dueAt, done])
}

model Contact {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  name          String
  email         String?
  title         String?
}

model EmailLog {
  id            String       @id @default(cuid())
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  userId        String
  subject       String
  body          String
  parsed        Json?
  confidence    Float?
  needsReview   Boolean      @default(true)
  receivedAt    DateTime     @default(now())
}
